{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".nvmrc",
    ".node-version",
    ".npmrc",
    "tsconfig.json",
    "packages/typescript-config/*.json"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        "!.env*"
      ],
      "env": [
        "VITE_*"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "HOST",
        "WEB_PORT",
        "API_*",
        "APP_*",
        "LOG_LEVEL",
        "CORS_*",
        "TRUST_PROXY_HOPS",
        "JSON_BODY_LIMIT_BYTES",
        "FORM_*",
        "HTTP_*",
        "SHUTDOWN_TIMEOUT_MS",
        "DATABASE_URL",
        "REDIS_URL",
        "FIREBASE_*",
        "GOOGLE_APPLICATION_CREDENTIALS",
        "AWS_*",
        "S3_*",
        "VITE_*"
      ]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/eslint-config/**",
        "$TURBO_ROOT$/packages/typescript-config/**"
      ],
      "outputs": []
    },
    "lint:fix": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.test*"
      ],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": [
        "coverage/**"
      ]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
