# ==================================================
# Application
# ==================================================

NODE_ENV=development
LOG_LEVEL=debug

# ==================================================
# Web Application
# ==================================================

WEB_PORT=3000
VITE_API_BASE_URL=http://localhost:4000/api/v1

# ==================================================
# API Application
# ==================================================

API_PORT=4000
API_HOST=0.0.0.0

# ==================================================
# PostgreSQL
# ==================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=excel_dashboard
POSTGRES_USER=excel_dashboard
POSTGRES_PASSWORD=local-development-only

DATABASE_URL=postgresql://excel_dashboard:local-development-only@localhost:5432/excel_dashboard

# ==================================================
# Redis
# ==================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ==================================================
# Object Storage
# ==================================================

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=excel-dashboard-local
S3_ACCESS_KEY_ID=local-access-key
S3_SECRET_ACCESS_KEY=local-secret-key
S3_FORCE_PATH_STYLE=true

# ==================================================
# Firebase Authentication
# ==================================================

FIREBASE_PROJECT_ID=excel-dashboard-local
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

VITE_FIREBASE_API_KEY=local-development-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=excel-dashboard-local
VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099

# ==================================================
# Background Workers
# ==================================================

INGESTION_WORKER_CONCURRENCY=2
ANALYTICS_WORKER_CONCURRENCY=2

# ==================================================
# Analytics
# ==================================================

ANALYTICS_QUERY_TIMEOUT_MS=30000
ANALYTICS_MAX_RESULT_ROWS=10000

# ==================================================
# Uploads
# ==================================================

MAX_UPLOAD_SIZE_BYTES=52428800
