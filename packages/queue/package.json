{
  "name": "@excel-dashboard/queue",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Redis and BullMQ infrastructure for Excel Dashboard",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:integration": "jest --config jest-integration.config.cjs --runInBand",
    "queue:main": "tsx scripts/queue-admin.ts"
  },
  "devDependencies": {
    "@excel-dashboard/eslint-config": "0.0.0",
    "@excel-dashboard/typescript-config": "0.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "dotenv": "18.0.10",
    "eslint": "9.39.1",
    "jest": "30.5.2",
    "testcontainers": "12.2.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "bullmq": "6.7.7",
    "ioredis": "6.0.0",
    "zod": "4.6.7"
  }
}
