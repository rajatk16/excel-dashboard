DATABASE_URL=postgresql://excel_dashboard:local-development-only@localhost:5432/excel_dashboard

# Optional dedicated connection for migrations.
# Falls back to DATABASE_URL when not supplied.
DATABASE_DIRECT_URL=postgresql://excel_dashboard:local-development-only@localhost:5432/excel_dashboard

# Connection pool
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Database query protection
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000

# Interactive transactions
DATABASE_TRANSACTION_MAX_WAIT_MS=5000
DATABASE_TRANSACTION_TIMEOUT_MS=10000

# Readiness
DATABASE_HEALTH_TIMEOUT_MS=2000

# Explicit opt-in for local seeding
DATABASE_ALLOW_SEED=false
