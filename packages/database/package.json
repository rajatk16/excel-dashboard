{
  "name": "@excel-dashboard/database",
  "version": "0.0.0",
  "private": true,
  "description": "Shared PostgreSQL and Prisma infrastructure for Excel Dashboard.",
  "type": "commonjs",
  "main": "./dis/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "npm run generate && tsc -p tsconfig.build.json",
    "typecheck": "npm run generate && tsc --noEmit -p tsconfig.json",
    "lint": "npm run generate && eslint . --max-warnings=0",
    "lint:fix": "npm run generate && eslint . --fix --max-warnings=0",
    "test": "npm run generate && jest --runInBand",
    "test:coverage": "npm run generate && jest --coverage --runInBand",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@excel-dashboard/eslint-config": "0.0.0",
    "@excel-dashboard/typescript-config": "0.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.10",
    "eslint": "9.39.1",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  }
}
