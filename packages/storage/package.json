{
  "name": "@excel-dashboard/storage",
  "version": "0.0.0",
  "private": true,
  "description": "Shared S3-compatible object storage infrastructure",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@excel-dashboard/eslint-config": "0.0.0",
    "@excel-dashboard/typescript-config": "0.0.0",
    "@types/node": "24.10.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "9.39.1",
    "testcontainers": "12.2.1",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1177.0",
    "@aws-sdk/lib-storage": "3.1177.0",
    "@aws-sdk/s3-request-presigner": "3.1177.0",
    "@smithy/node-http-handler": "4.14.2",
    "zod": "4.6.7"
  }
}
