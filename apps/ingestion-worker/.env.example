NODE_ENV=development

WORKER_NAME=excel-dashboard-ingestion-worker

WORKER_CONCURRENCY=2

WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=4101

WORKER_LOCK_DURATION_MS=30000
WORKER_STALLED_INTERVAL_MS=30000
WORKER_MAX_STALLED_COUNT=1

REDIS_URL=redis://:local-development-only@127.0.0.1:6379/0

QUEUE_PREFIX=excel-dashboard-local

REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=3000

QUEUE_HEALTH_TIMEOUT_MS=2000
QUEUE_SHUTDOWN_TIMEOUT_MS=30000
