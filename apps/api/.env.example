# Application
NODE_ENV=development
APP_NAME=excel-dashboard-api
APP_VERSION=0.0.0

# HTTP server
API_HOST=0.0.0.0
API_PORT=4000

# Logging
LOG_LEVEL=debug

# Security
CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=false
TRUST_PROXY_HOPS=0

# HTTP request limits
JSON_BODY_LIMIT_BYTES=1048576
FORM_BODY_LIMIT_BYTES=32768
FORM_PARAMETER_LIMIT=100

# HTTP server timeouts
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000

# Shutdown
SHUTDOWN_TIMEOUT_MS=15000

# PostgreSQL
DATABASE_URL=postgresql://excel_dashboard:local-development-only@localhost:5432/excel_dashboard

DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000

DATABASE_TRANSACTION_MAX_WAIT_MS=5000
DATABASE_TRANSACTION_TIMEOUT_MS=10000

DATABASE_HEALTH_TIMEOUT_MS=2000
