{
  "name": "excel-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "A multi-tenant SaaS platform for transforming spreadsheets into interactive analytics dashboard",
  "license": "UNLICENSED",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.6.2 <12.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "main": "index.js",
  "scripts": {
    "preinstall": "node scripts/check-environment.mjs",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@excel-dashboard/web",
    "dev:api": "turbo run dev --filter=@excel-dashboard/api",
    "dev:injestion": "turbo run dev --filter=@excel-dashboard/injestion-worker",
    "dev:analytics": "turbo run dev --filter=@excel-dashboard/analytics-worker",
    "build": "turbo run build",
    "build:affected": "turbo run build --affected",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:affected": "turbo run test --affected",
    "test:coverage": "turbo run test:coverage",
    "check": "turbo run lint typecheck test build",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all",
    "doctor": "node scripts/check-environment.mjs",
    "graph": "turbo run build --graph=dependency-graph.html"
  },
  "devDependencies": {
    "turbo": "2.11.11",
    "typescript": "7.0.2"
  },
  "keywords": [],
  "author": "",
  "type": "commonjs"
}
